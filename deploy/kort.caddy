# Kort. Install as /etc/caddy/sites/kort.caddy, then: sudo systemctl reload caddy
# Everything (pages, API, media) sits behind the shared Google login. The server trusts the
# Remote-Email header that the login sets; client-sent Remote-* headers are stripped first.
# The iPhone Shortcut opens kort.gallab.top/import?url=… in the browser, which carries the login cookie.
kort.gallab.top {
    encode zstd gzip
    header {
        X-Robots-Tag "noindex, nofollow"
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    route {
        request_header -Remote-User
        request_header -Remote-Email
        request_header -Remote-Name
        request_header -Remote-Groups

        # Icons and the web manifest are public: phones fetch them WITHOUT the login cookie when
        # adding the site to the home screen, and would otherwise show a letter instead of an icon.
        @public path /manifest.json /logo.png /icon.png /icon-192.png /icon-512.png /icon-maskable-512.png /apple-touch-icon.png /favicon-16.png /favicon-32.png
        handle @public {
            header Cache-Control "public, max-age=86400"
            reverse_proxy 127.0.0.1:8787
        }

        import auth
        reverse_proxy 127.0.0.1:8787
    }
}
