# Server port
PORT=8787

# Postgres (on the gallab server: the kort-db container). Locally: any Postgres, e.g.
# docker run -d --name kort-db -e POSTGRES_USER=kort -e POSTGRES_PASSWORD=kort -e POSTGRES_DB=kort -p 5433:5432 postgres:17-alpine
DATABASE_URL=postgres://kort:kort@127.0.0.1:5433/kort

# Images and videos: folder on disk and the URL they are served from (the server serves /media itself).
MEDIA_DIR=media
MEDIA_BASE_URL=/media
# Where other gallab sites reach Kort (the Saw page on woody.gallab.top loads thumbnails from here)
KORT_PUBLIC_URL=https://kort.gallab.top

# Identity. On the server HUB_AUTH=1: Caddy + the gallab Google login set Remote-Email on every request.
# Locally leave HUB_AUTH unset and name yourself:
HUB_AUTH=0
DEV_USER_EMAIL=you@example.com
# Only these accounts may use Kort (comma-separated). Empty = anyone the login lets through.
KORT_ALLOWED_EMAILS=

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Optional: audio transcription of reels (OpenAI Whisper). Leave empty to skip audio.
OPENAI_API_KEY=

# Optional: paths to binaries if they are not on PATH
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg

# Optional: a Netscape cookies.txt exported from a logged-in browser.
COOKIES_FILE=

# Optional but recommended: ScrapeCreators API key for stable Facebook/Instagram imports (scrapecreators.com)
SCRAPECREATORS_API_KEY=

# Optional: stock photos for recipes without an image (free key from unsplash.com/developers)
UNSPLASH_ACCESS_KEY=
